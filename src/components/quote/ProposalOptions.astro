---
// Fixed proposal shown on /p/<token> when Eric composed the quote himself.
// Handles one option (a single itemised proposal, read-only) or several
// (Opció A/B/C — each a card with its own total; the couple picks one). A
// single "accept" per option records a response via the same endpoint as the
// interactive configurator, sending only the option index so the server
// resolves the packs/extras/lines and the total can't be tampered with.
import { PACKS, EXTRAS } from '~/data/packs';
import { formatEuros, calculateSelectionTotals, sumCustomLines } from '~/lib/pricing';
import { type Lang } from '~/i18n/ui';

interface OptionInput {
  label: string;
  packIds: string[];
  extraIds: string[];
  customLines: { description: string; cents: number; isGift?: boolean }[];
}
interface Props {
  lang: Lang;
  token: string;
  options: OptionInput[];
  adminDiscountCents: number;
  validUntilText?: string | null;
  /** True once the couple has already accepted — render the read-only thanks. */
  alreadyResponded: boolean;
  /** WhatsApp link for questions. */
  whatsappUrl: string;
}
const {
  lang, token, options, adminDiscountCents,
  validUntilText = null, alreadyResponded, whatsappUrl,
} = Astro.props;

const multi = options.length > 1;
const views = options.map((o) => {
  const packs = PACKS.filter((p) => o.packIds.includes(p.id));
  const extras = EXTRAS.filter((x) => o.extraIds.includes(x.id));
  const customCents = sumCustomLines(o.customLines);
  const totals = calculateSelectionTotals(o.packIds, o.extraIds, adminDiscountCents, customCents);
  return { label: o.label, packs, extras, customLines: o.customLines, totals };
});

const TX = {
  ca: { headingSingle: 'La vostra proposta', headingMulti: 'Les vostres opcions', subSingle: 'Aquesta és la proposta que hem preparat per a vosaltres.', subMulti: 'Hem preparat aquestes opcions perquè trieu la que més us encaixi.', total: 'Total', discount: 'Descompte', accept: 'Acceptar la proposta', choose: 'Triar aquesta opció', accepting: 'Enviant…', accepted: 'Opció triada ✓', thanksTitle: 'Rebut!', thanksBody: 'Gràcies. Ens hi posem i us escrivim de seguida.', wa: 'Tens dubtes? Escriu-nos per WhatsApp', payNote: 'Preus amb IVA inclòs. El pagament es formalitza amb la reserva.' },
  es: { headingSingle: 'Vuestra propuesta', headingMulti: 'Vuestras opciones', subSingle: 'Esta es la propuesta que hemos preparado para vosotros.', subMulti: 'Hemos preparado estas opciones para que elijáis la que más os encaje.', total: 'Total', discount: 'Descuento', accept: 'Aceptar la propuesta', choose: 'Elegir esta opción', accepting: 'Enviando…', accepted: 'Opción elegida ✓', thanksTitle: '¡Recibido!', thanksBody: 'Gracias. Nos ponemos en marcha y os escribimos enseguida.', wa: '¿Dudas? Escríbenos por WhatsApp', payNote: 'Precios con IVA incluido. El pago se formaliza con la reserva.' },
  en: { headingSingle: 'Your proposal', headingMulti: 'Your options', subSingle: 'This is the proposal we have prepared for you.', subMulti: 'We have prepared these options — pick the one that fits you best.', total: 'Total', discount: 'Discount', accept: 'Accept the proposal', choose: 'Choose this option', accepting: 'Sending…', accepted: 'Option chosen ✓', thanksTitle: 'Got it!', thanksBody: 'Thank you. We are on it and will write to you shortly.', wa: 'Questions? Message us on WhatsApp', payNote: 'Prices include VAT. Payment is settled with the booking.' },
}[lang];
---

<section class="px-6 md:px-12 py-14 md:py-20 bg-cream text-ink" id="proposta">
  <div class="max-w-2xl mx-auto">
    <div class="text-center mb-8">
      <h2 class="font-display text-3xl md:text-4xl font-bold mb-2">{multi ? TX.headingMulti : TX.headingSingle}</h2>
      <p class="text-ink/70">{multi ? TX.subMulti : TX.subSingle}</p>
    </div>

    <div id="fp-feedback" hidden class="mb-6 p-4 border-l-4 border-gold bg-white"></div>

    {alreadyResponded && (
      <div class="mb-6 p-4 border-l-4 border-gold bg-white">
        <p class="font-bold mb-1">{TX.thanksTitle}</p>
        <p class="text-sm text-ink/80">{TX.thanksBody}</p>
      </div>
    )}

    <div class="space-y-6">
      {views.map((v, i) => (
        <div class="bg-white border border-line">
          {multi && (
            <div class="px-5 py-3 border-b border-line bg-cream/40">
              <p class="font-display text-xl font-bold">{v.label}</p>
            </div>
          )}
          <ul class="divide-y divide-line">
            {v.packs.map((p) => (
              <li class="flex items-baseline justify-between gap-4 px-5 py-4">
                <span>
                  <span class="font-display text-lg font-bold">{p.name[lang]}</span>
                  {p.subtitle && <span class="block text-xs text-ink/60">{p.subtitle[lang]}</span>}
                </span>
                <span class="font-bold whitespace-nowrap">{p.price}</span>
              </li>
            ))}
            {v.extras.map((x) => (
              <li class="flex items-baseline justify-between gap-4 px-5 py-3">
                <span class="text-ink/85">{x.name[lang]}</span>
                <span class="font-semibold whitespace-nowrap">{x.price}</span>
              </li>
            ))}
            {v.customLines.map((l) => (
              <li class="flex items-baseline justify-between gap-4 px-5 py-3">
                <span class="text-ink/85">
                  {l.description}
                  {l.isGift && <span class="ml-2 text-[0.6rem] font-bold tracking-[0.14em] uppercase px-1.5 py-0.5 rounded-sm bg-gold/20 text-gold-deep align-middle">Regal</span>}
                </span>
                {l.isGift ? (
                  <span class="whitespace-nowrap">{l.cents > 0 && <span class="line-through text-ink/40">{formatEuros(l.cents)} </span>}<span class="font-bold text-gold-deep">0 €</span></span>
                ) : (
                  <span class="font-semibold whitespace-nowrap">{formatEuros(l.cents)}</span>
                )}
              </li>
            ))}
            {adminDiscountCents > 0 && (
              <li class="flex items-baseline justify-between gap-4 px-5 py-3 text-gold-deep">
                <span>{TX.discount}</span>
                <span class="font-semibold whitespace-nowrap">−{formatEuros(adminDiscountCents)}</span>
              </li>
            )}
          </ul>
          <div class="flex items-baseline justify-between gap-4 px-5 py-4 border-t-2 border-ink bg-cream/40">
            <span class="font-display text-xl font-bold">{TX.total}</span>
            <span class="font-display text-3xl font-bold text-gold-deep whitespace-nowrap">{formatEuros(v.totals.totalCents)}</span>
          </div>
          {!alreadyResponded && (
            <div class="px-5 pb-5 pt-4">
              <button
                type="button"
                class="fp-accept w-full bg-ink text-white py-4 text-xs font-bold tracking-[0.18em] uppercase hover:bg-gold hover:text-ink transition-colors disabled:opacity-50"
                data-token={token}
                data-index={i}
              >
                {multi ? TX.choose : TX.accept}
              </button>
            </div>
          )}
        </div>
      ))}
    </div>

    <p class="text-xs text-ink/60 mt-3">{TX.payNote}</p>
    {validUntilText && <p class="text-xs text-ink/60 italic mt-1">{validUntilText}</p>}

    <div class="text-center mt-4">
      <a href={whatsappUrl} target="_blank" rel="noopener" class="text-xs font-bold tracking-[0.14em] uppercase text-gold-deep hover:underline">
        {TX.wa}
      </a>
    </div>
  </div>
</section>

<script
  is:inline
  define:vars={{
    acceptingLabel: TX.accepting,
    acceptedLabel: TX.accepted,
    thanksTitle: TX.thanksTitle,
    thanksBody: TX.thanksBody,
  }}
>
  (() => {
    const buttons = Array.from(document.querySelectorAll('.fp-accept'));
    if (!buttons.length) return;
    const feedback = document.getElementById('fp-feedback');
    buttons.forEach((btn) => {
      btn.addEventListener('click', async () => {
        buttons.forEach((b) => { b.disabled = true; });
        const original = btn.textContent;
        btn.textContent = acceptingLabel;
        try {
          const res = await fetch('/api/quotes/' + btn.dataset.token + '/respond', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ optionIndex: Number(btn.dataset.index) }),
          });
          if (!res.ok) throw new Error('HTTP ' + res.status);
          btn.textContent = acceptedLabel;
          if (feedback) {
            feedback.hidden = false;
            feedback.innerHTML = '<p class="font-bold mb-1">' + thanksTitle + '</p><p class="text-sm">' + thanksBody + '</p>';
            feedback.scrollIntoView({ behavior: 'smooth', block: 'center' });
          }
        } catch (err) {
          console.error('[proposal-options] accept failed', err);
          buttons.forEach((b) => { b.disabled = false; });
          btn.textContent = original;
        }
      });
    });
  })();
</script>
