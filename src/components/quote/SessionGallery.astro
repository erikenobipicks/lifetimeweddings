---
// Sample couple-session gallery shown on a session-mode /p/<token> proposal,
// in place of the wedding real-wedding / showcase proof blocks. Uses the
// curated couple-session set already in the repo
// (public/blog/sesion-de-fotos-de-pareja) so the couple sees the exact style
// of the shoot they're being quoted. Static asset list — no CMS.
import { useTranslations, type Lang } from '~/i18n/ui';
import { SITE } from '~/data/site';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useTranslations(lang);
const instagramUrl = SITE.social.instagram;
const instagramHandle = '@lifetime.weddings';

const BASE = '/blog/sesion-de-fotos-de-pareja';
// Curated set (skips cover.webp, which is a duplicate crop).
const IMAGES = [
  'mirada',
  'carretera',
  'platja',
  'cascada',
  'natural',
  'mural',
  'decorar',
  'regalo',
];
---

<section class="px-6 md:px-12 py-16 md:py-20 bg-white text-ink" data-service="photo">
  <div class="max-w-5xl mx-auto">
    <p class="text-xs font-bold tracking-[0.22em] uppercase text-gold-deep mb-3 text-center">
      {t('quote.session.gallery.eyebrow')}
    </p>
    <h2 class="font-display text-2xl md:text-3xl font-bold text-center mb-10 max-w-2xl mx-auto">
      {t('quote.session.gallery.heading')}
    </h2>
    <div class="grid grid-cols-2 md:grid-cols-4 gap-2 md:gap-3">
      {IMAGES.map((name, i) => (
        <img
          src={`${BASE}/${name}.webp`}
          alt=""
          loading="lazy"
          decoding="async"
          class:list={[
            'w-full h-full object-cover bg-cream',
            // A couple of tall features for rhythm on wider screens.
            i === 0 || i === 5 ? 'row-span-2 aspect-[3/4] md:aspect-auto' : 'aspect-square',
          ]}
        />
      ))}
    </div>

    <div class="mt-8 text-center">
      <a
        href={instagramUrl}
        target="_blank"
        rel="noopener"
        class="inline-flex items-center gap-2 text-sm font-bold tracking-[0.06em] text-ink hover:text-gold-deep transition-colors"
      >
        <svg viewBox="0 0 24 24" class="w-5 h-5" aria-hidden="true" fill="currentColor">
          <path d="M12 2.16c3.2 0 3.58.01 4.85.07 1.17.05 1.8.25 2.23.41.56.22.96.48 1.38.9.42.42.68.82.9 1.38.16.42.36 1.06.41 2.23.06 1.27.07 1.65.07 4.85s-.01 3.58-.07 4.85c-.05 1.17-.25 1.8-.41 2.23-.22.56-.48.96-.9 1.38-.42.42-.82.68-1.38.9-.42.16-1.06.36-2.23.41-1.27.06-1.65.07-4.85.07s-3.58-.01-4.85-.07c-1.17-.05-1.8-.25-2.23-.41a3.72 3.72 0 0 1-1.38-.9 3.72 3.72 0 0 1-.9-1.38c-.16-.42-.36-1.06-.41-2.23C2.17 15.58 2.16 15.2 2.16 12s.01-3.58.07-4.85c.05-1.17.25-1.8.41-2.23.22-.56.48-.96.9-1.38.42-.42.82-.68 1.38-.9.42-.16 1.06-.36 2.23-.41C8.42 2.17 8.8 2.16 12 2.16Zm0 1.44c-3.15 0-3.52.01-4.76.07-1.15.05-1.77.24-2.19.41-.55.21-.94.47-1.35.88-.41.41-.67.8-.88 1.35-.17.42-.36 1.04-.41 2.19-.06 1.24-.07 1.61-.07 4.76s.01 3.52.07 4.76c.05 1.15.24 1.77.41 2.19.21.55.47.94.88 1.35.41.41.8.67 1.35.88.42.17 1.04.36 2.19.41 1.24.06 1.61.07 4.76.07s3.52-.01 4.76-.07c1.15-.05 1.77-.24 2.19-.41.55-.21.94-.47 1.35-.88.41-.41.67-.8.88-1.35.17-.42.36-1.04.41-2.19.06-1.24.07-1.61.07-4.76s-.01-3.52-.07-4.76c-.05-1.15-.24-1.77-.41-2.19a3.63 3.63 0 0 0-.88-1.35 3.63 3.63 0 0 0-1.35-.88c-.42-.17-1.04-.36-2.19-.41-1.24-.06-1.61-.07-4.76-.07Zm0 2.45a5.95 5.95 0 1 1 0 11.9 5.95 5.95 0 0 1 0-11.9Zm0 1.44a4.51 4.51 0 1 0 0 9.02 4.51 4.51 0 0 0 0-9.02Zm6.16-.32a1.39 1.39 0 1 1-2.78 0 1.39 1.39 0 0 1 2.78 0Z"/>
        </svg>
        <span>{t('quote.session.instagram')} {instagramHandle}</span>
      </a>
    </div>
  </div>
</section>
