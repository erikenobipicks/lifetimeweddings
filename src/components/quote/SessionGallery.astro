---
// Sample couple-session gallery shown on a session-mode /p/<token> proposal,
// in place of the wedding real-wedding / showcase proof blocks. Uses the
// curated couple-session set already in the repo
// (public/blog/sesion-de-fotos-de-pareja) so the couple sees the exact style
// of the shoot they're being quoted. Static asset list — no CMS.
import { useTranslations, type Lang } from '~/i18n/ui';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useTranslations(lang);

const BASE = '/blog/sesion-de-fotos-de-pareja';
// Curated set (skips cover.webp, which is a duplicate crop).
const IMAGES = [
  'mirada',
  'carretera',
  'platja',
  'cascada',
  'natural',
  'mural',
  'decorar',
  'regalo',
];
---

<section class="px-6 md:px-12 py-16 md:py-20 bg-white text-ink" data-service="photo">
  <div class="max-w-5xl mx-auto">
    <p class="text-xs font-bold tracking-[0.22em] uppercase text-gold-deep mb-3 text-center">
      {t('quote.session.gallery.eyebrow')}
    </p>
    <h2 class="font-display text-2xl md:text-3xl font-bold text-center mb-10 max-w-2xl mx-auto">
      {t('quote.session.gallery.heading')}
    </h2>
    <div class="grid grid-cols-2 md:grid-cols-4 gap-2 md:gap-3">
      {IMAGES.map((name, i) => (
        <img
          src={`${BASE}/${name}.webp`}
          alt=""
          loading="lazy"
          decoding="async"
          class:list={[
            'w-full h-full object-cover bg-cream',
            // A couple of tall features for rhythm on wider screens.
            i === 0 || i === 5 ? 'row-span-2 aspect-[3/4] md:aspect-auto' : 'aspect-square',
          ]}
        />
      ))}
    </div>
  </div>
</section>
