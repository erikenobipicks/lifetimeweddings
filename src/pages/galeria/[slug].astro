---
export const prerender = true;
import { ENTREGUES } from '~/data/entregas';
import { PHOTOS, type Photo } from '~/data/photos.generated';

export function getStaticPaths() {
  return ENTREGUES.map((e) => ({ params: { slug: e.slug }, props: { site: e } }));
}

const { site } = Astro.props;
const names = `${site.couple.a} ${site.nameSep} ${site.couple.b}`;

const set = PHOTOS[site.photoSet];
const images: Photo[] = set?.images ?? [];
const byId = (suffix?: string) =>
  suffix ? images.find((im) => im.id.endsWith(`/${suffix}`)) : undefined;
const landscapes = images.filter((im) => im.orientation !== 'portrait');
const portraits = images.filter((im) => im.orientation === 'portrait');

const heroImg = byId(site.photos?.hero) ?? portraits[0] ?? landscapes[0] ?? images[0];
const explicitFeatured = (site.photos?.featured ?? [])
  .map((s) => byId(s))
  .filter((im): im is Photo => Boolean(im));
const featured = explicitFeatured.length
  ? explicitFeatured
  : images.filter((im) => im.id !== heroImg?.id);

const webp = (p: string) => p.replace(/\.jpg$/, '.webp');
---

<!doctype html>
<html lang={site.lang}>
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<meta name="robots" content="noindex, nofollow" />
<title>{names} · {site.pageTitle}</title>
<link rel="icon" type="image/png" href="/favicon.png" />
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link
  href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,300;0,9..144,400;0,9..144,500;0,9..144,600;1,9..144,400;1,9..144,500&family=Work+Sans:wght@300;400;500;600&display=swap"
  rel="stylesheet"
/>
<style>
  :root{
    --cream:#F3EEE1; --cream-2:#E9E0CC; --ink:#2B2A22; --ink-soft:#55523F;
    --olive:#535E3D; --olive-dark:#3A4229; --gold:#B98A3E; --white:#FFFDF8;
    --display:'Fraunces', serif; --body:'Work Sans', sans-serif;
  }
  *{box-sizing:border-box; margin:0; padding:0;}
  html{scroll-behavior:smooth;}
  body{font-family:var(--body); background:var(--cream); color:var(--ink); line-height:1.6; font-weight:300; overflow-x:hidden;}
  h1,h2,h3{font-family:var(--display); font-weight:500; color:var(--ink);}
  a{color:inherit;}
  img{display:block; max-width:100%;}

  .eyebrow{font-family:var(--body); text-transform:uppercase; letter-spacing:0.28em; font-size:0.7rem; font-weight:600; color:var(--gold);}
  .wrap{max-width:1100px; margin:0 auto; padding:0 6vw;}
  section{padding:6rem 0;}
  .head{text-align:center; max-width:640px; margin:0 auto 3.4rem;}
  .head .eyebrow{margin-bottom:0.9rem;}
  .head h2{font-size:clamp(2rem, 5vw, 2.8rem); font-weight:500;}
  .divider{width:64px; height:1px; background:var(--gold); margin:1.6rem auto 0;}

  /* HERO */
  .hero{position:relative; min-height:100svh; display:flex; flex-direction:column; align-items:center; justify-content:center; text-align:center; color:var(--white); overflow:hidden;}
  .hero-bg{position:absolute; inset:0; z-index:0;}
  .hero-bg picture{display:block; width:100%; height:100%;}
  .hero-bg img{width:100%; height:100%; object-fit:cover; object-position:center 28%;}
  .hero-bg::after{content:""; position:absolute; inset:0; background:linear-gradient(180deg, rgba(42,41,30,0.32) 0%, rgba(42,41,30,0.42) 55%, rgba(42,41,30,0.78) 100%);}
  .hero-bg--empty{background:radial-gradient(120% 120% at 50% 15%, #5B6647 0%, #3A4229 45%, #2B2A22 100%);}
  .hero-content{position:relative; z-index:1; padding:4rem 6vw 0;}
  .hero .eyebrow{color:var(--cream); opacity:0.85; margin-bottom:1.4rem;}
  .hero h1{font-size:clamp(3rem, 9vw, 6.5rem); font-style:italic; font-weight:400; line-height:1; letter-spacing:0.01em; color:var(--white);}
  .hero h1 .sep{font-style:normal; font-weight:300; opacity:0.9; margin:0 0.15em;}
  .hero .date{margin-top:1.4rem; font-size:1.05rem; letter-spacing:0.08em;}
  .hero .place{margin-top:0.3rem; font-size:0.9rem; letter-spacing:0.15em; text-transform:uppercase; opacity:0.75;}
  .scroll-cue{position:absolute; bottom:2.2rem; left:50%; transform:translateX(-50%); z-index:1; width:1px; height:44px; background:rgba(255,253,248,0.5);}
  .scroll-cue::after{content:""; position:absolute; top:0; left:-3px; width:7px; height:7px; border-radius:50%; background:var(--gold); animation:cue 2.2s ease-in-out infinite;}
  @keyframes cue{ 0%{top:0; opacity:1;} 90%{top:38px; opacity:0;} 100%{top:38px; opacity:0;} }

  /* INTRO */
  .intro{padding:5rem 0 1rem; text-align:center; background:var(--white);}
  .intro p{max-width:640px; margin:0 auto; font-size:1.2rem; font-style:italic; font-family:var(--display); font-weight:400; color:var(--ink-soft); line-height:1.7;}

  /* FEATURED — masonry-ish columns so mixed orientations sit nicely. */
  .featured{background:var(--white);}
  .masonry{columns:2; column-gap:0.8rem;}
  .masonry figure{break-inside:avoid; margin:0 0 0.8rem; overflow:hidden; border-radius:2px;}
  .masonry img{width:100%; height:auto; transition:transform 0.6s ease;}
  .masonry figure:hover img{transform:scale(1.03);}

  /* GALLERY CTA */
  .gallery-cta{background:var(--olive-dark); color:var(--cream); text-align:center;}
  .gallery-cta .eyebrow{color:var(--gold);}
  .gallery-cta h2{color:var(--cream); font-size:clamp(2rem,5vw,2.8rem); margin:0.9rem 0 1rem;}
  .gallery-cta p{max-width:520px; margin:0 auto 2.2rem; color:#D8D3BD; font-size:1rem;}

  .btn{display:inline-block; background:var(--gold); color:var(--ink); border:none; padding:1rem 2.6rem; font-family:var(--body); font-size:0.85rem; letter-spacing:0.1em; text-transform:uppercase; font-weight:600; cursor:pointer; text-decoration:none; transition:transform 0.2s ease, background 0.3s ease;}
  .btn:hover{transform:translateY(-2px);}
  .btn--outline{background:transparent; color:var(--olive); border:1px solid var(--olive);}
  .btn--outline:hover{background:var(--olive); color:var(--white);}

  /* REVIEW */
  .review{background:var(--cream-2); text-align:center;}
  .review .eyebrow{margin-bottom:0.9rem;}
  .review h2{font-size:clamp(1.8rem,4.5vw,2.5rem); margin-bottom:1rem;}
  .review p{max-width:560px; margin:0 auto 2.2rem; color:var(--ink-soft); font-size:1rem;}

  /* FOOTER */
  footer{background:var(--ink); color:var(--cream); text-align:center; padding:4rem 0 3rem;}
  footer h2{color:var(--cream); font-style:italic; font-weight:400; font-size:1.9rem; margin-bottom:0.6rem;}
  footer p{opacity:0.75; font-size:0.9rem;}
  footer .fine{opacity:0.5; font-size:0.78rem; max-width:420px; margin:1.8rem auto 0; line-height:1.6;}

  @media(max-width:820px){
    .hero{justify-content:flex-end;}
    .hero-content{padding-top:0; padding-bottom:2.2rem;}
    .hero-bg img{object-position:center 32%;}
    .hero-bg::after{background:linear-gradient(180deg, rgba(42,41,30,0.15) 0%, rgba(42,41,30,0.32) 40%, rgba(42,41,30,0.72) 100%);}
    .scroll-cue{display:none;}
    .masonry{columns:1;}
    section{padding:4.5rem 0;}
  }
  @media(prefers-reduced-motion:reduce){
    html{scroll-behavior:auto;}
    .masonry img, .btn{transition:none;}
    .scroll-cue::after{animation:none;}
  }
</style>
</head>
<body>

<header class="hero">
  {heroImg ? (
    <div class="hero-bg">
      <picture>
        <source type="image/webp" srcset={webp(heroImg.variants.lg)} />
        <img src={heroImg.variants.lg} alt={names} fetchpriority="high" />
      </picture>
    </div>
  ) : (
    <div class="hero-bg hero-bg--empty"></div>
  )}
  <div class="hero-content">
    <p class="eyebrow">{site.eyebrow}</p>
    <h1>{site.couple.a} <span class="sep">{site.nameSep}</span> {site.couple.b}</h1>
    <p class="date">{site.dateLabel}</p>
    {site.place && <p class="place">{site.place}</p>}
  </div>
  <div class="scroll-cue"></div>
</header>

<section class="intro">
  <div class="wrap"><p>{site.intro}</p></div>
</section>

{featured.length > 0 && (
  <section class="featured">
    <div class="wrap">
      <div class="head">
        <p class="eyebrow">{site.featuredEyebrow}</p>
        <h2>{site.featuredHeading}</h2>
        <div class="divider"></div>
      </div>
      <div class="masonry">
        {featured.map((im, i) => (
          <figure>
            <picture>
              <source type="image/webp" srcset={webp(im.variants.md)} />
              <img src={im.variants.md} alt={`${names} — ${i + 1}`} loading="lazy" />
            </picture>
          </figure>
        ))}
      </div>
    </div>
  </section>
)}

<section class="gallery-cta">
  <div class="wrap">
    <p class="eyebrow">{site.galleryEyebrow}</p>
    <h2>{site.galleryHeading}</h2>
    <p>{site.galleryBody}</p>
    <a class="btn" href={site.galleryUrl} target="_blank" rel="noopener noreferrer">{site.galleryCta}</a>
  </div>
</section>

<section class="review">
  <div class="wrap">
    <p class="eyebrow">{site.reviewEyebrow}</p>
    <h2>{site.reviewHeading}</h2>
    <p>{site.reviewBody}</p>
    <a class="btn btn--outline" href={site.reviewUrl} target="_blank" rel="noopener noreferrer">{site.reviewCta}</a>
  </div>
</section>

<footer>
  <div class="wrap">
    <h2>{names}</h2>
    <p>{site.footerContact} <a href={`mailto:${site.email}`}>{site.email}</a></p>
    {site.footerNote && <p class="fine">{site.footerNote}</p>}
  </div>
</footer>

</body>
</html>
