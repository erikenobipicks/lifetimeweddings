---
import AdminLayout from '~/layouts/AdminLayout.astro';
import { createQuote, getLeadById, linkLeadToQuote, addQuoteOption, getQuoteById } from '~/lib/quotes';
import { PACKS, OWN_EXTRAS, EXTERNAL_EXTRAS, getComposedSubpacks } from '~/data/packs';
import { eurosStringToCents } from '~/lib/payments/money';
import { recommendPacks } from '~/lib/matcher';
import { publicVideos, fullVideos } from '~/data/videos';
import { SHOWCASES } from '~/data/showcases';
import { WEDDINGS } from '~/data/weddings';
import { externalGalleries } from '~/data/external-galleries';

// Support ?lead=<id> deep-link from Telegram/email so the form comes
// pre-filled with the lead's name/email and the recommended packs ticked.
const leadId = Number(Astro.url.searchParams.get('lead'));
const lead = Number.isFinite(leadId) && leadId > 0 ? await getLeadById(leadId) : null;

// Support ?addOption=<quoteId>: reuse this same composer to append an option to
// an existing proposal (Opció B/C…) instead of creating a whole new quote.
const addOptionId = Number(Astro.url.searchParams.get('addOption'));
const addOptionQuote = Number.isFinite(addOptionId) && addOptionId > 0 ? await getQuoteById(addOptionId) : null;

let error: string | null = null;
let createdToken: string | null = null;
let createdQuoteId: number | null = null;
let createdQuoteEmail: string | null = null;
let postedLeadId: number | null = null;

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const coupleName = String(form.get('couple_name') ?? '').trim();
  const coupleEmail = String(form.get('couple_email') ?? '').trim();
  const packIds = form.getAll('packs').map(String);
  const extraIds = form.getAll('extras').map(String);
  const isFixed = form.get('is_fixed') === 'on' || form.get('is_fixed') === '1';
  // Custom lines: parallel arrays of description + euros price → {description,
  // cents, isGift}. Gift checkboxes carry the row index as their value (unchecked
  // boxes don't submit, so a Set of the submitted indices is how we know which
  // rows are gifts). Gift lines are kept even without a price (they show "Regal"
  // / a struck value and add 0 to the total); normal lines still need a price.
  const clDescs = form.getAll('custom_line_desc').map(String);
  const clPrices = form.getAll('custom_line_price').map(String);
  const giftIdx = new Set(form.getAll('custom_line_gift').map((v) => Number(v)));
  const customLines = clDescs
    .map((d, i) => {
      const c = eurosStringToCents(clPrices[i] ?? '');
      return { description: d.trim(), cents: Number.isFinite(c) && c > 0 ? c : 0, isGift: giftIdx.has(i) };
    })
    .filter((l) => l.description && (l.isGift || l.cents > 0));
  const optionLabel = String(form.get('option_label') ?? '').trim();
  const postedAddOption = Number(form.get('add_option_to') ?? '');
  const isAddOption = Number.isFinite(postedAddOption) && postedAddOption > 0;

  // Adding an option to an existing proposal — append and bounce back to it.
  if (isAddOption) {
    if (packIds.length === 0) {
      error = 'Selecciona almenys un pack per a l\'opció.';
    } else {
      await addQuoteOption(postedAddOption, {
        label: optionLabel || 'Opció',
        packIds,
        extraIds,
        customLines,
      });
      return Astro.redirect(`/admin/${postedAddOption}?ok=option-added#opcions`);
    }
  }

  const notes = String(form.get('notes') ?? '').trim();
  const password = String(form.get('password') ?? '').trim();
  const expiresAt = String(form.get('expires_at') ?? '').trim();
  const offerTitle = String(form.get('offer_title') ?? '').trim();
  const offerBody = String(form.get('offer_body') ?? '').trim();
  const offerDeadline = String(form.get('offer_deadline') ?? '').trim();
  const flagshipVideoId = String(form.get('flagship_video_id') ?? '').trim();
  const flagshipShowcaseSlug = String(form.get('flagship_showcase_slug') ?? '').trim();
  const flagshipWeddingSlug = String(form.get('flagship_wedding_slug') ?? '').trim();
  const flagshipExternalGalleryUrl = String(form.get('flagship_external_gallery_url') ?? '').trim();
  const langRaw = String(form.get('preferred_language') ?? '').trim();
  const preferredLanguage: 'ca' | 'es' | 'en' =
    langRaw === 'es' || langRaw === 'en' ? langRaw : 'ca';
  const siRaw = String(form.get('service_interest') ?? '').trim();
  const serviceInterest: 'photo' | 'video' | 'both' | 'undecided' =
    siRaw === 'photo' || siRaw === 'video' || siRaw === 'undecided' ? siRaw : 'both';
  const linkLeadId = Number(form.get('lead_id') ?? '');
  postedLeadId = Number.isFinite(linkLeadId) && linkLeadId > 0 ? linkLeadId : null;

  if (isAddOption) {
    // handled above (redirect on success, or `error` set) — skip create
  } else if (!coupleName) {
    error = 'Cal el nom de la parella.';
  } else if (packIds.length === 0) {
    error = 'Selecciona almenys un pack.';
  } else {
    const q = await createQuote({
      coupleName,
      coupleEmail: coupleEmail || undefined,
      packIds,
      notes: notes || undefined,
      password: password || undefined,
      expiresAt: expiresAt ? new Date(expiresAt).toISOString() : undefined,
      createdBy: Astro.locals.user,
      flagshipVideoId: flagshipVideoId || undefined,
      flagshipShowcaseSlug: flagshipShowcaseSlug || undefined,
      flagshipWeddingSlug: flagshipWeddingSlug || undefined,
      flagshipExternalGalleryUrl: flagshipExternalGalleryUrl || undefined,
      preferredLanguage,
      serviceInterest,
      offerTitle: offerTitle || undefined,
      offerBody: offerBody || undefined,
      offerDeadline: offerDeadline || undefined,
      leadId: postedLeadId ?? undefined,
      extraIds: extraIds.length ? extraIds : undefined,
      isFixed,
      customLines: customLines.length ? customLines : undefined,
      optionLabel: optionLabel || undefined,
    });
    if (postedLeadId) {
      // Also keep the legacy one-to-one link pointing at (the latest) proposal.
      try { await linkLeadToQuote(postedLeadId, q.id); } catch { /* non-fatal */ }
    }
    createdToken = q.token;
    createdQuoteId = q.id;
    createdQuoteEmail = q.coupleEmail ?? null;
  }
}

const siteUrl = import.meta.env.PUBLIC_SITE_URL ?? Astro.url.origin;

// Pre-fill values: form resubmission errors preserve user input; lead deep-link
// populates from DB; otherwise everything is blank.
const initialName = lead?.coupleName ?? '';
const initialEmail = lead?.email ?? '';
const initialLanguage: 'ca' | 'es' | 'en' = lead?.preferredLanguage ?? 'ca';
// Service interest pre-fill from the lead's quiz answer; falls back to
// 'both' (the most permissive default — better the couple sees too many
// options than too few).
const initialServiceInterest: 'photo' | 'video' | 'both' | 'undecided' =
  lead?.serviceInterest === 'photo' ? 'photo'
  : lead?.serviceInterest === 'video' ? 'video'
  : 'both';
const recommendedPackIds: string[] = lead
  ? recommendPacks({
      weddingDate: lead.weddingDate ?? undefined,
      location: lead.location ?? 'tarragona',
      ceremonyType: lead.ceremonyType ?? 'civil',
      serviceInterest: lead.serviceInterest ?? 'both',
      budgetRange: lead.budgetRange ?? 'mid',
    })
  : [];

const LABELS: Record<string, string> = {
  tarragona: 'Tarragona/Reus', barcelona: 'Barcelona', lleida: 'Lleida/Girona',
  other_cat: 'Catalunya', international: 'Internacional',
  civil: 'Civil', religious: 'Religiosa', symbolic: 'Simbòlica',
  photo: 'Foto', video: 'Vídeo', both: 'Foto+Vídeo',
  low: '< 1.500 €', mid: '1.500-2.500 €', high: '2.500-3.500 €', premium: '> 3.500 €',
};
---

<AdminLayout title="Nou pressupost">
  <h1 class="font-display text-2xl sm:text-3xl font-bold mb-6 sm:mb-8">
    {addOptionQuote ? 'Afegir una opció' : 'Nou pressupost'}
  </h1>

  {addOptionQuote && (
    <div class="mb-8 bg-gold/5 border-2 border-gold/50 p-5">
      <p class="text-xs font-bold tracking-widest uppercase text-gold-deep mb-2">➕ Nova opció per a: {addOptionQuote.coupleName}</p>
      <p class="text-sm text-ink/75">
        Compon aquesta opció (nom + packs + extres + línies). S'afegirà a la mateixa proposta i sortirà com una opció més al mateix enllaç.
        Els camps de la parella i de la pàgina ja estan definits a la proposta; aquí només tries què inclou aquesta opció.
      </p>
      <a href={`/admin/${addOptionQuote.id}`} class="inline-block mt-3 text-xs font-bold tracking-widest uppercase text-gold-deep hover:underline">← Tornar a la proposta</a>
    </div>
  )}

  {lead && !createdToken && !addOptionQuote && (
    <div class="mb-8 bg-cream border border-gold/40 p-5">
      <p class="text-xs font-bold tracking-widest uppercase text-gold mb-3">Respostes del quiz · lead #{lead.id}</p>
      <dl class="grid sm:grid-cols-2 gap-2 text-sm mb-3">
        <div><dt class="inline text-ink/70">Parella:</dt> <dd class="inline font-bold">{lead.coupleName}</dd></div>
        <div><dt class="inline text-ink/70">Email:</dt> <dd class="inline">{lead.email}</dd></div>
        {lead.phone && <div><dt class="inline text-ink/70">Tel:</dt> <dd class="inline">{lead.phone}</dd></div>}
        {lead.weddingDate && <div><dt class="inline text-ink/70">Data:</dt> <dd class="inline">{lead.weddingDate}</dd></div>}
        {lead.location && <div><dt class="inline text-ink/70">Lloc:</dt> <dd class="inline">{LABELS[lead.location] ?? lead.location}</dd></div>}
        {lead.venueName && <div><dt class="inline text-ink/70">Finca:</dt> <dd class="inline font-bold">{lead.venueName}</dd></div>}
        {lead.ceremonyType && <div><dt class="inline text-ink/70">Cerimònia:</dt> <dd class="inline">{LABELS[lead.ceremonyType] ?? lead.ceremonyType}</dd></div>}
        {lead.serviceInterest && <div><dt class="inline text-ink/70">Servei:</dt> <dd class="inline">{LABELS[lead.serviceInterest] ?? lead.serviceInterest}</dd></div>}
        {lead.budgetRange && <div><dt class="inline text-ink/70">Pressupost:</dt> <dd class="inline">{LABELS[lead.budgetRange] ?? lead.budgetRange}</dd></div>}
      </dl>
      <p class="text-xs text-ink/70">🤖 Packs pre-marcats segons la recomanació automàtica. Marca/desmarca els que vulguis abans de crear l'enllaç.</p>
    </div>
  )}

  {createdToken && (
    <div class="mb-8 bg-white border border-gold p-6">
      <p class="text-sm font-bold tracking-widest uppercase text-gold mb-2">✓ Creat</p>
      <p class="mb-3 text-ink/80">
        {createdQuoteEmail
          ? `Aquest és l'enllaç únic. Envia'l directament a ${createdQuoteEmail} o copia'l:`
          : "Aquest és l'enllaç únic. Copia'l i envia'l a la parella:"}
      </p>
      <div class="flex flex-wrap gap-2">
        <input
          readonly
          value={`${siteUrl}/p/${createdToken}`}
          class="flex-1 min-w-[180px] px-3 py-2 border border-line bg-cream font-mono text-sm"
          id="token-url"
        />
        <button
          type="button"
          data-copy={`${siteUrl}/p/${createdToken}`}
          class="bg-ink text-white px-4 py-2 text-xs font-bold tracking-widest uppercase hover:bg-gold hover:text-ink transition-colors whitespace-nowrap"
        >
          Copiar
        </button>
        {createdQuoteEmail && createdQuoteId && (
          <button
            type="button"
            data-send-quote
            data-quote-id={createdQuoteId}
            data-email={createdQuoteEmail}
            class="bg-gold text-ink px-4 py-2 text-xs font-bold tracking-widest uppercase hover:brightness-110 transition whitespace-nowrap"
          >
            📧 Enviar
          </button>
        )}
      </div>
      {createdQuoteEmail && (
        <p class="text-[0.7rem] text-ink/70 mt-2" data-send-feedback></p>
      )}
      <div class="mt-4 flex gap-3 text-xs">
        <a href="/admin" class="text-gold underline">← Tornar al llistat</a>
        <a href="/admin/new" class="text-gold underline">+ Crear-ne un altre</a>
      </div>
    </div>
  )}

  {error && <p class="mb-6 p-3 bg-red-50 border border-red-200 text-red-700 text-sm">{error}</p>}

  <form method="POST" class="max-w-2xl space-y-6 bg-white p-6 border border-line">
    {lead && <input type="hidden" name="lead_id" value={lead.id} />}
    {addOptionQuote && <input type="hidden" name="add_option_to" value={addOptionQuote.id} />}

    <div>
      <label for="option_label" class="block text-xs font-bold tracking-widest uppercase mb-1.5">
        Nom de l'opció {addOptionQuote ? '*' : '(opcional)'}
      </label>
      <input id="option_label" name="option_label" maxlength="60" required={!!addOptionQuote}
             class="w-full px-3 py-2 border border-line focus:border-gold focus:outline-none"
             placeholder="Ex: Foto essencial" />
      <p class="text-[0.7rem] text-ink/70 mt-1">Nom curt de l'opció. Si la proposta té diverses opcions, la parella el veurà com a títol de cada targeta (ex: "Foto essencial", "Foto + vídeo").</p>
    </div>

    {!addOptionQuote && (
    <>
    <div>
      <label for="couple_name" class="block text-xs font-bold tracking-widest uppercase mb-1.5">Nom de la parella *</label>
      <input id="couple_name" name="couple_name" required={!addOptionQuote} value={initialName}
             class="w-full px-3 py-2 border border-line focus:border-gold focus:outline-none"
             placeholder="Luis & Craig" />
    </div>

    <div>
      <label for="couple_email" class="block text-xs font-bold tracking-widest uppercase mb-1.5">Email (opcional)</label>
      <input id="couple_email" name="couple_email" type="email" value={initialEmail}
             class="w-full px-3 py-2 border border-line focus:border-gold focus:outline-none" />
    </div>

    <div>
      <p class="text-xs font-bold tracking-widest uppercase mb-2">Servei que volen</p>
      <p class="text-[0.7rem] text-ink/70 mb-3 -mt-1">Filtra què veurà la parella al configurador interactiu del pressupost. Si dubten, deixa "encara dubten" — així veuen tot.</p>
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-2">
        {[
          { v: 'photo',     label: '📸 Foto' },
          { v: 'video',     label: '🎬 Vídeo' },
          { v: 'both',      label: '💍 Foto + vídeo' },
          { v: 'undecided', label: '🤔 Encara dubten' },
        ].map((opt) => (
          <label class="block">
            <input
              type="radio"
              name="service_interest"
              value={opt.v}
              checked={initialServiceInterest === opt.v}
              class="sr-only peer"
            />
            <span class="block text-xs font-bold tracking-widest uppercase text-center px-3 py-2 border border-line cursor-pointer hover:border-gold peer-checked:bg-ink peer-checked:text-white peer-checked:border-ink transition-colors">
              {opt.label}
            </span>
          </label>
        ))}
      </div>
    </div>
    </>
    )}

    <div>
      <p class="text-xs font-bold tracking-widest uppercase mb-3">Packs a mostrar *</p>
      <p class="text-[0.7rem] text-ink/70 mb-3 -mt-2">Clica el ▾ per veure el detall que veurà la parella al pressupost.</p>
      <div class="space-y-2">
        {PACKS.map((p) => {
          const subpacks = getComposedSubpacks(p);
          return (
            <details class="border border-line bg-white open:border-gold/40">
              <summary class="cursor-pointer list-none flex items-start gap-3 p-3 hover:bg-cream">
                <input type="checkbox" name="packs" value={p.id}
                       checked={recommendedPackIds.includes(p.id)}
                       onclick="event.stopPropagation()"
                       class="mt-1 accent-gold" />
                <span class="flex-1">
                  <span class="font-bold">{p.name.ca}</span>
                  <span class="block text-xs text-ink/70">{p.type} · {p.price}</span>
                </span>
                <span class="text-ink/40 text-sm leading-none mt-1 select-none">▾</span>
              </summary>
              <div class="px-4 pb-4 -mt-1 border-t border-line pt-3 space-y-3">
                {subpacks.length > 0 ? (
                  <>
                    {subpacks.map((sp) => (
                      <div>
                        <p class="text-[0.7rem] font-bold uppercase tracking-wide text-ink/70 mb-1">{sp.name.ca}</p>
                        <ul class="space-y-1.5 text-sm text-ink/80">
                          {sp.includes.ca.map((it) => (
                            <li class="flex gap-2"><span class="text-gold shrink-0">✓</span><span>{it}</span></li>
                          ))}
                        </ul>
                      </div>
                    ))}
                    {p.includes.ca.length > 0 && (
                      <div class="pt-2 border-t border-line">
                        <p class="text-[0.7rem] font-bold uppercase tracking-wide text-gold mb-1">I junts:</p>
                        <ul class="space-y-1.5 text-sm text-ink/80">
                          {p.includes.ca.map((it) => (
                            <li class="flex gap-2"><span class="text-gold shrink-0">✓</span><span>{it}</span></li>
                          ))}
                        </ul>
                      </div>
                    )}
                  </>
                ) : (
                  <ul class="space-y-1.5 text-sm text-ink/80">
                    {p.includes.ca.map((it) => (
                      <li class="flex gap-2"><span class="text-gold shrink-0">✓</span><span>{it}</span></li>
                    ))}
                  </ul>
                )}
              </div>
            </details>
          );
        })}
      </div>
    </div>

    <div>
      <p class="text-xs font-bold tracking-widest uppercase mb-2">Extres a incloure</p>
      <p class="text-[0.7rem] text-ink/70 mb-3 -mt-1">Marca els extres que formen part d'aquesta proposta (preus amb IVA inclòs).</p>

      {/* Our own photo/video add-ons — shown open and up front so they're the
          first thing on hand when composing a proposal. */}
      <div class="border border-gold/40 bg-gold/5">
        <p class="px-4 py-3 text-xs font-bold tracking-widest uppercase text-gold-deep border-b border-gold/30">
          📸 Foto i vídeo <span class="text-ink/50 font-normal normal-case tracking-normal">· els nostres serveis</span>
        </p>
        <ul class="divide-y divide-line px-4 pb-3">
          {OWN_EXTRAS.map((x) => (
            <li class="py-2">
              <label class="flex items-start gap-3 cursor-pointer">
                <input type="checkbox" name="extras" value={x.id} class="mt-1 accent-gold" />
                <span class="flex-1 flex items-start justify-between gap-3">
                  <span>
                    <span class="text-ink font-medium">{x.name.ca}</span>
                    {x.note && <span class="block text-[0.7rem] text-ink/70 mt-0.5">{x.note.ca}</span>}
                  </span>
                  <span class="font-bold text-gold whitespace-nowrap">{x.price}</span>
                </span>
              </label>
            </li>
          ))}
        </ul>
      </div>

      {/* Resold third-party services — collapsed by default (secondary). */}
      <details class="border border-line bg-white mt-3">
        <summary class="cursor-pointer px-4 py-3 text-xs font-bold tracking-widest uppercase text-ink/70 hover:text-gold select-none">
          ＋ Serveis externs <span class="text-ink/50 font-normal normal-case tracking-normal">· fotomatón, 360º, etc.</span>
        </summary>
        <ul class="divide-y divide-line px-4 pb-3">
          {EXTERNAL_EXTRAS.map((x) => (
            <li class="py-2">
              <label class="flex items-start gap-3 cursor-pointer">
                <input type="checkbox" name="extras" value={x.id} class="mt-1 accent-gold" />
                <span class="flex-1 flex items-start justify-between gap-3">
                  <span>
                    <span class="text-ink">{x.name.ca}</span>
                    {x.note && <span class="block text-[0.7rem] text-ink/70 mt-0.5">{x.note.ca}</span>}
                  </span>
                  <span class="font-bold text-gold whitespace-nowrap">{x.price}</span>
                </span>
              </label>
            </li>
          ))}
        </ul>
      </details>
    </div>

    <div>
      <p class="text-xs font-bold tracking-widest uppercase mb-2">Línies personalitzades (opcional)</p>
      <p class="text-[0.7rem] text-ink/70 mb-3 -mt-1">Conceptes lliures amb el preu (IVA inclòs). Marca "Regal" perquè surti amb el valor tatxat i sumi 0 €. En pots afegir més després, des de la fitxa del pressupost.</p>
      <div class="space-y-2">
        {[0, 1, 2].map((i) => (
          <div class="grid grid-cols-[1fr_130px] gap-x-2 gap-y-1 items-center">
            <input name="custom_line_desc" type="text" maxlength="200" placeholder="Concepte (ex: Àlbum per als avis)" class="px-3 py-2 border border-line focus:border-gold focus:outline-none" />
            <input name="custom_line_price" type="text" inputmode="decimal" placeholder="€ (IVA inc.)" class="px-3 py-2 border border-line focus:border-gold focus:outline-none" />
            <label class="col-span-2 flex items-center gap-2 text-[0.7rem] text-ink/70 cursor-pointer pl-1">
              <input type="checkbox" name="custom_line_gift" value={i} class="accent-gold" />
              🎁 Regal (valor tatxat, suma 0 €)
            </label>
          </div>
        ))}
      </div>
    </div>

    {!addOptionQuote && (
    <>
    <label class="flex items-start gap-3 border border-gold/50 bg-gold/5 p-3">
      <input type="checkbox" name="is_fixed" checked class="mt-0.5 accent-gold" />
      <span class="text-sm">
        <span class="font-bold">Proposta fixa</span>
        <span class="block text-[0.7rem] text-ink/70">La parella veurà exactament aquesta proposta (packs + extres + línies) amb el total, sense poder reconfigurar-la. Desmarca-ho per deixar el configurador interactiu on la parella tria.</span>
      </span>
    </label>

    <div>
      <label for="notes" class="block text-xs font-bold tracking-widest uppercase mb-1.5">Notes personals (opcional)</label>
      <textarea id="notes" name="notes" rows="3"
                class="w-full px-3 py-2 border border-line focus:border-gold focus:outline-none resize-y"
                placeholder="Missatge personalitzat que veurà la parella a la pàgina…"></textarea>
    </div>

    <fieldset class="border border-gold/50 bg-gold/5 p-4">
      <legend class="px-2 text-xs font-bold tracking-widest uppercase text-gold-deep">🎁 Oferta amb data límit (opcional)</legend>
      <p class="text-[0.7rem] text-ink/70 mb-3">Surt com un bloc destacat amb compte enrere a la pàgina de la parella. Deixa el títol en blanc si no vols oferir res.</p>
      <div class="space-y-3">
        <div>
          <label for="offer_title" class="block text-xs font-bold tracking-widest uppercase mb-1.5">Títol de l'oferta</label>
          <input id="offer_title" name="offer_title"
                 class="w-full px-3 py-2 border border-line bg-white focus:border-gold focus:outline-none"
                 placeholder="Ex: Sessió de prenoces de regal" />
        </div>
        <div>
          <label for="offer_body" class="block text-xs font-bold tracking-widest uppercase mb-1.5">Descripció</label>
          <textarea id="offer_body" name="offer_body" rows="2"
                    class="w-full px-3 py-2 border border-line bg-white focus:border-gold focus:outline-none resize-y"
                    placeholder="Ex: Contractant abans de la data límit, la sessió de prenoces (entre setmana) va de regal."></textarea>
        </div>
        <div class="max-w-xs">
          <label for="offer_deadline" class="block text-xs font-bold tracking-widest uppercase mb-1.5">Data límit</label>
          <input id="offer_deadline" name="offer_deadline" type="date"
                 class="w-full px-3 py-2 border border-line bg-white focus:border-gold focus:outline-none" />
          <p class="text-[0.7rem] text-ink/70 mt-1">Opcional. Amb data, surt el compte enrere ("Queden X dies") i s'amaga sola quan passa.</p>
        </div>
      </div>
    </fieldset>

    <details class="border border-line bg-cream/40">
      <summary class="cursor-pointer px-4 py-3 text-xs font-bold tracking-widest uppercase text-ink/70 hover:text-gold select-none">
        ⚙ Opcions avançades
      </summary>
      <div class="px-4 pb-4 pt-2 grid md:grid-cols-2 gap-4">
        <div>
          <label for="expires_at" class="block text-xs font-bold tracking-widest uppercase mb-1.5">Caduca</label>
          <input id="expires_at" name="expires_at" type="date"
                 class="w-full px-3 py-2 border border-line bg-white focus:border-gold focus:outline-none" />
          <p class="text-[0.7rem] text-ink/70 mt-1">L'enllaç deixarà de funcionar després d'aquesta data.</p>
        </div>
        <div>
          <label for="password" class="block text-xs font-bold tracking-widest uppercase mb-1.5">Contrasenya</label>
          <input id="password" name="password"
                 class="w-full px-3 py-2 border border-line bg-white focus:border-gold focus:outline-none"
                 placeholder="Deixa-ho en blanc" />
          <p class="text-[0.7rem] text-ink/70 mt-1">Capa extra de seguretat si voleu que la parella introdueixi una paraula per obrir el pressupost.</p>
        </div>
        <div>
          <label for="preferred_language" class="block text-xs font-bold tracking-widest uppercase mb-1.5">Idioma</label>
          <select id="preferred_language" name="preferred_language"
                  class="w-full px-3 py-2 border border-line bg-white focus:border-gold focus:outline-none">
            <option value="ca" selected={initialLanguage === 'ca'}>Català</option>
            <option value="es" selected={initialLanguage === 'es'}>Castellano</option>
            <option value="en" selected={initialLanguage === 'en'}>English</option>
          </select>
          <p class="text-[0.7rem] text-ink/70 mt-1">L'idioma en què veurà la parella la pàgina del pressupost. Si ve d'un lead, ja ve pre-seleccionat.</p>
        </div>
        <div class="md:col-span-2">
          <label for="flagship_video_id" class="block text-xs font-bold tracking-widest uppercase mb-1.5">Vídeo destacat</label>
          <select id="flagship_video_id" name="flagship_video_id"
                  class="w-full px-3 py-2 border border-line bg-white focus:border-gold focus:outline-none">
            <option value="">— Per defecte (Elena i Jordi) —</option>
            <optgroup label="Tràilers">
              {publicVideos.map((v) => (
                <option value={v.youtubeId}>{v.coupleName} · {v.venue}</option>
              ))}
            </optgroup>
            {fullVideos.length > 0 && (
              <optgroup label="Bodes senceres (ocultes a YouTube)">
                {fullVideos.map((v) => (
                  <option value={v.youtubeId}>
                    {v.coupleName} · {v.venue}{v.adminNote ? ` · ${v.adminNote}` : ''}
                  </option>
                ))}
              </optgroup>
            )}
          </select>
          <p class="text-[0.7rem] text-ink/70 mt-1">Els tràilers són curts; les bodes senceres són la versió completa que envies un cop la parella està enganxada (després d'una videocall, per exemple). En blanc → per defecte.</p>
        </div>

        <div class="md:col-span-2">
          <label for="flagship_wedding_slug" class="block text-xs font-bold tracking-widest uppercase mb-1.5">Galeria de fotos destacada — Boda real</label>
          <select id="flagship_wedding_slug" name="flagship_wedding_slug"
                  class="w-full px-3 py-2 border border-line bg-white focus:border-gold focus:outline-none">
            <option value="">— Cap (deixar automàtic) —</option>
            {WEDDINGS.map((w) => (
              <option value={w.slug}>{w.couple} · {w.venue} · {w.location}</option>
            ))}
          </select>
          <p class="text-[0.7rem] text-ink/70 mt-1">Si tries una boda real, la parella la veurà com a referència al pressupost. Té prioritat sobre el showcase.</p>
        </div>

        <div class="md:col-span-2">
          <label for="flagship_showcase_slug" class="block text-xs font-bold tracking-widest uppercase mb-1.5">Galeria de fotos destacada — Showcase temàtic</label>
          <select id="flagship_showcase_slug" name="flagship_showcase_slug"
                  class="w-full px-3 py-2 border border-line bg-white focus:border-gold focus:outline-none">
            <option value="">— Cap (deixar automàtic) —</option>
            {SHOWCASES.map((s) => (
              <option value={s.slug}>{s.title.ca}</option>
            ))}
          </select>
          <p class="text-[0.7rem] text-ink/70 mt-1">Alternativa al \"boda real\": un tipus de boda genèric. Si deixes les dues en blanc, es dedueix del lead (si n'hi ha).</p>
        </div>

        <div class="md:col-span-2">
          <label for="flagship_external_gallery_url" class="block text-xs font-bold tracking-widest uppercase mb-1.5">Galeria externa</label>
          {externalGalleries.length > 0 && (
            <select
              id="flagship_external_gallery_picker"
              data-gallery-picker
              class="w-full px-3 py-2 border border-line bg-white focus:border-gold focus:outline-none mb-2"
            >
              <option value="">— Trieu una galeria del catàleg, o enganxeu URL a sota —</option>
              {externalGalleries.map((g) => (
                <option value={g.url}>
                  {g.coupleName} · {g.venue}{g.adminNote ? ` · ${g.adminNote}` : ''}
                </option>
              ))}
            </select>
          )}
          <input id="flagship_external_gallery_url" name="flagship_external_gallery_url" type="url"
                 placeholder="https://gallery.fotostudio.io/objectiu-fotografs/..."
                 class="w-full px-3 py-2 border border-line bg-white focus:border-gold focus:outline-none" />
          <p class="text-[0.7rem] text-ink/70 mt-1">Si poses una URL de galeria de FotoStudio (o similar), s'incrusta a la pàgina del pressupost. Si la galeria no es deixa embedar, surt un botó per obrir-la en una pestanya nova automàticament.</p>
        </div>
      </div>
    </details>
    </>
    )}

    <button type="submit"
            class="bg-ink text-white px-8 py-3 text-xs font-bold tracking-widest uppercase hover:bg-gold hover:text-ink transition-colors">
      {addOptionQuote ? 'Afegir opció a la proposta' : 'Crear i generar enllaç'}
    </button>
  </form>
</AdminLayout>

<script>
  document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((btn) => {
    btn.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(btn.dataset.copy!);
        const old = btn.textContent;
        btn.textContent = '✓ Copiat';
        setTimeout(() => (btn.textContent = old), 1500);
      } catch {
        prompt('Copia:', btn.dataset.copy!);
      }
    });
  });

  // Mirrors the same data-send-quote handler on /admin/<id> so creating
  // from a lead → email is one click without leaving the page.
  document.querySelectorAll<HTMLButtonElement>('[data-send-quote]').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const quoteId = Number(btn.dataset.quoteId);
      const email = btn.dataset.email ?? '';
      const feedback = document.querySelector<HTMLElement>('[data-send-feedback]');
      if (!confirm(`Enviar l'enllaç del pressupost a ${email}?`)) return;
      btn.disabled = true;
      const old = btn.textContent;
      btn.textContent = 'Enviant…';
      try {
        const res = await fetch('/api/admin/send-quote', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ quoteId }),
        });
        if (!res.ok) throw new Error('HTTP ' + res.status);
        btn.textContent = '✓ Enviat';
        if (feedback) {
          feedback.textContent = `Enviat a ${email} · ` + new Date().toLocaleString('ca-ES');
          feedback.style.color = '#c9a96e';
        }
      } catch (err) {
        console.error(err);
        btn.textContent = old ?? '📧 Enviar';
        if (feedback) {
          feedback.textContent = 'Error enviant. Torna-ho a provar.';
          feedback.style.color = '#b91c1c';
        }
      } finally {
        setTimeout(() => { btn.disabled = false; }, 2000);
      }
    });
  });

  // External-gallery picker → URL input. The hidden source of truth is the
  // URL input (what the server reads); the picker is just a shortcut that
  // pastes the catalogue URL when selected. Manual URLs still work.
  const galleryPicker = document.querySelector<HTMLSelectElement>('[data-gallery-picker]');
  const galleryUrl = document.querySelector<HTMLInputElement>('#flagship_external_gallery_url');
  if (galleryPicker && galleryUrl) {
    galleryPicker.addEventListener('change', () => {
      if (galleryPicker.value) galleryUrl.value = galleryPicker.value;
    });
  }
</script>
