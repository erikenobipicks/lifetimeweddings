---
// Admin: view/edit a single material-delivery landing page.
import AdminLayout from '~/layouts/AdminLayout.astro';
import { getDeliveryById, listDeliveryRevisions } from '~/lib/deliveries';
import { getBookingById, listPayments } from '~/lib/bookings/repository';
import { isStripeEnabled } from '~/lib/payments/config';

const id = Astro.params.id!;
const delivery = await getDeliveryById(id);

if (!delivery) {
  return new Response('Not found', { status: 404 });
}

const okFlag = Astro.url.searchParams.get('ok');
const errorMsg = Astro.url.searchParams.get('error');
const invoiceNum = Astro.url.searchParams.get('num');
const siteUrl = import.meta.env.PUBLIC_SITE_URL ?? Astro.url.origin;
const publicUrl = `${siteUrl}/entrega/${delivery.slug}`;

function ymd(d: Date | null): string {
  return d ? d.toISOString().slice(0, 10) : '';
}
function eurosField(cents: number | null): string {
  return cents != null ? (cents / 100).toFixed(2).replace('.', ',') : '';
}
function eurStr(cents: number): string {
  return `${(cents / 100).toLocaleString('es-ES', { minimumFractionDigits: 2, maximumFractionDigits: 2 })} €`;
}

// Linked-booking pending balance (for the "import" button). Same formula as
// the booking detail page: effective price − payments recorded.
let bookingPendingCents = 0;
const linkedBooking = delivery.bookingId ? await getBookingById(delivery.bookingId) : null;
if (linkedBooking) {
  const payments = await listPayments(linkedBooking.id);
  const totalCents = Math.max(0, linkedBooking.packPriceCents - linkedBooking.discountCents);
  const paidCents = payments.reduce((acc, p) => acc + p.amountCents, 0);
  bookingPendingCents = Math.max(0, totalCents - paidCents);
}

// Change requests the couple submitted. Grouped by submission batch (newest
// first, preserving each batch's original item order).
const revisions = await listDeliveryRevisions(id);
const revisionBatches = (() => {
  const map = new Map<string, typeof revisions>();
  for (const r of revisions) {
    const arr = map.get(r.batchId) ?? [];
    arr.push(r);
    map.set(r.batchId, arr);
  }
  return [...map.values()];
})();
const pendingRevisions = revisions.filter((r) => r.status === 'pending').length;
function dtStr(d: Date): string {
  return d.toLocaleString('es-ES', { dateStyle: 'medium', timeStyle: 'short' });
}

const balancePaidStr = delivery.balancePaidAt
  ? delivery.balancePaidAt.toLocaleString('es-ES', { dateStyle: 'medium', timeStyle: 'short' })
  : null;
const stripeOn = isStripeEnabled();
---

<AdminLayout title={`${delivery.coupleName1} i ${delivery.coupleName2} · Entrega`}>
  <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3 mb-6">
    <h1 class="font-display text-2xl sm:text-3xl font-bold">{delivery.coupleName1} i {delivery.coupleName2}</h1>
    <a href="/admin/deliveries" class="text-xs font-bold tracking-widest uppercase text-ink/70 hover:text-gold whitespace-nowrap">← Tornar al llistat</a>
  </div>

  {okFlag === 'created' && (
    <div class="mb-4 px-4 py-3 bg-emerald-50 border border-emerald-200 text-emerald-800 text-sm">✓ Entrega creada. Copia l'enllaç per enviar-lo a la parella.</div>
  )}
  {okFlag === 'updated' && (
    <div class="mb-4 px-4 py-3 bg-emerald-50 border border-emerald-200 text-emerald-800 text-sm">✓ Canvis desats.</div>
  )}
  {okFlag === 'archived' && (
    <div class="mb-4 px-4 py-3 bg-emerald-50 border border-emerald-200 text-emerald-800 text-sm">✓ Entrega arxivada — l'enllaç públic deixa de funcionar.</div>
  )}
  {okFlag === 'reactivated' && (
    <div class="mb-4 px-4 py-3 bg-emerald-50 border border-emerald-200 text-emerald-800 text-sm">✓ Entrega reactivada.</div>
  )}
  {okFlag === 'balance_paid' && (
    <div class="mb-4 px-4 py-3 bg-emerald-50 border border-emerald-200 text-emerald-800 text-sm">✓ Import pendent marcat com a pagat.</div>
  )}
  {okFlag === 'balance_unpaid' && (
    <div class="mb-4 px-4 py-3 bg-emerald-50 border border-emerald-200 text-emerald-800 text-sm">✓ Pagament del pendent desmarcat.</div>
  )}
  {okFlag === 'invoice_issued' && (
    <div class="mb-4 px-4 py-3 bg-emerald-50 border border-emerald-200 text-emerald-800 text-sm">✓ Factura creada a FacturaDirecta{invoiceNum ? ` (núm. ${invoiceNum})` : ''}.</div>
  )}
  {okFlag === 'revision_updated' && (
    <div class="mb-4 px-4 py-3 bg-emerald-50 border border-emerald-200 text-emerald-800 text-sm">✓ Canvi actualitzat.</div>
  )}
  {errorMsg && (
    <div class="mb-4 px-4 py-3 bg-red-50 border border-red-200 text-red-900 text-sm"><strong>Error:</strong> {errorMsg}</div>
  )}

  {/* Public link — the thing you actually share with the couple. */}
  <div class="bg-white border border-line p-5 md:p-6 mb-6">
    <p class="text-xs font-bold tracking-widest uppercase text-ink/70 mb-2">Enllaç públic</p>
    <div class="flex flex-wrap items-center gap-3">
      <code class="text-sm bg-cream px-3 py-2 border border-line break-all">{publicUrl}</code>
      <button type="button" id="copy-link-btn" data-copy={publicUrl} class="text-gold text-xs font-bold tracking-widest uppercase hover:underline whitespace-nowrap">Copiar</button>
      <a href={`/entrega/${delivery.slug}`} target="_blank" rel="noopener" class="text-ink/70 text-xs font-bold tracking-widest uppercase hover:text-gold whitespace-nowrap">Veure la pàgina ↗</a>
    </div>
    {delivery.archived && (
      <p class="text-xs text-amber-800 mt-3">⚠ Aquesta entrega està arxivada — l'enllaç mostra "no disponible" fins que la reactivis.</p>
    )}
  </div>

  {/* Change requests the couple submitted from /entrega. Grouped by round,
      each item tickable done/pending. */}
  {revisions.length > 0 && (
    <div id="canvis" class="bg-white border-2 border-ink/15 p-5 md:p-6 mb-6 scroll-mt-24">
      <p class="text-xs font-bold tracking-widest uppercase mb-4">
        🎬 Canvis demanats
        {pendingRevisions > 0 && (
          <span class="ml-2 inline-block bg-gold text-ink px-2 py-0.5 text-[0.65rem] rounded-sm">{pendingRevisions} pendent{pendingRevisions === 1 ? '' : 's'}</span>
        )}
      </p>
      <div class="space-y-5">
        {revisionBatches.map((batch) => (
          <div>
            <p class="text-[0.7rem] text-ink/50 mb-2">{dtStr(batch[0].createdAt)}</p>
            <ul class="space-y-2">
              {batch.map((r) => (
                <li class={`flex items-start gap-3 border border-line px-3 py-2.5 ${r.status === 'done' ? 'bg-emerald-50/60' : 'bg-white'}`}>
                  <form method="POST" action={`/api/admin/deliveries/${delivery.id}/update`} class="shrink-0 pt-0.5">
                    <input type="hidden" name="_action" value="revision-status" />
                    <input type="hidden" name="revisionId" value={r.id} />
                    <input type="hidden" name="status" value={r.status === 'done' ? 'pending' : 'done'} />
                    <button type="submit" title={r.status === 'done' ? 'Marcar com a pendent' : 'Marcar com a fet'}
                            class={`w-5 h-5 flex items-center justify-center border text-xs ${r.status === 'done' ? 'bg-emerald-500 border-emerald-500 text-white' : 'border-ink/30 text-transparent hover:border-gold'}`}>✓</button>
                  </form>
                  <div class="flex-1 min-w-0">
                    <p class={`text-sm ${r.status === 'done' ? 'line-through text-ink/50' : 'text-ink'}`}>
                      {r.timecode && <span class="font-mono font-bold text-gold-deep mr-1.5">{r.timecode}</span>}
                      {r.text}
                    </p>
                  </div>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>
  )}

  <form method="POST" action={`/api/admin/deliveries/${delivery.id}/update`} enctype="multipart/form-data" class="space-y-8 bg-white border border-line p-6 md:p-8">
    <input type="hidden" name="_action" value="update" />

    <fieldset class="space-y-4">
      <legend class="font-display text-xl font-bold mb-3">Bàsics</legend>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <label class="block">
          <span class="text-xs font-bold tracking-widest uppercase text-ink/70">Nom 1 *</span>
          <input name="coupleName1" required value={delivery.coupleName1} class="mt-1 w-full px-3 py-2 border border-line bg-white focus:border-gold focus:outline-none" />
        </label>
        <label class="block">
          <span class="text-xs font-bold tracking-widest uppercase text-ink/70">Nom 2 *</span>
          <input name="coupleName2" required value={delivery.coupleName2} class="mt-1 w-full px-3 py-2 border border-line bg-white focus:border-gold focus:outline-none" />
        </label>
        <label class="block">
          <span class="text-xs font-bold tracking-widest uppercase text-ink/70">Data de la boda *</span>
          <input type="date" name="weddingDate" required value={ymd(delivery.weddingDate)} class="mt-1 w-full px-3 py-2 border border-line bg-white focus:border-gold focus:outline-none" />
        </label>
        <label class="block">
          <span class="text-xs font-bold tracking-widest uppercase text-ink/70">Finca / lloc</span>
          <input name="venueName" value={delivery.venueName ?? ''} class="mt-1 w-full px-3 py-2 border border-line bg-white focus:border-gold focus:outline-none" />
        </label>
        <label class="block">
          <span class="text-xs font-bold tracking-widest uppercase text-ink/70">Idioma de la pàgina *</span>
          <select name="preferredLanguage" required class="mt-1 w-full px-3 py-2 border border-line bg-white focus:border-gold focus:outline-none">
            {[['ca', 'Català'], ['es', 'Castellano'], ['en', 'English']].map(([code, label]) => (
              <option value={code} selected={delivery.preferredLanguage === code}>{label}</option>
            ))}
          </select>
        </label>
      </div>
    </fieldset>

    <fieldset class="space-y-4">
      <legend class="font-display text-xl font-bold mb-1">Vídeo</legend>
      <p class="text-[11px] text-ink/70 -mt-2 mb-2">opcional · vídeos de YouTube ocults. Pots enganxar l'ID o l'URL sencera.</p>
      <label class="block max-w-lg">
        <span class="text-xs font-bold tracking-widest uppercase text-ink/70">Tràiler (ID o URL)</span>
        <span class="block text-[11px] text-ink/70 mb-1">opcional · si n'hi ha, es mostra ABANS del vídeo. Buit = no apareix.</span>
        <input name="trailerVideoId" value={delivery.trailerYoutubeId ?? ''} placeholder="https://youtu.be/xxxxxxxxxxx" class="mt-1 w-full px-3 py-2 border border-line bg-white focus:border-gold focus:outline-none" />
      </label>
      <label class="block max-w-lg">
        <span class="text-xs font-bold tracking-widest uppercase text-ink/70">Vídeo de YouTube (ID o URL)</span>
        <input name="youtubeVideoId" value={delivery.youtubeVideoId ?? ''} placeholder="https://youtu.be/xxxxxxxxxxx" class="mt-1 w-full px-3 py-2 border border-line bg-white focus:border-gold focus:outline-none" />
      </label>
    </fieldset>

    <fieldset class="space-y-4">
      <legend class="font-display text-xl font-bold mb-1">Descàrrega del vídeo</legend>
      <p class="text-[11px] text-ink/70 -mt-2 mb-2">opcional · enllaç de SwissTransfer (o similar).</p>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <label class="block">
          <span class="text-xs font-bold tracking-widest uppercase text-ink/70">Enllaç de descàrrega</span>
          <input name="swisstransferUrl" value={delivery.swisstransferUrl ?? ''} placeholder="https://www.swisstransfer.com/d/…" class="mt-1 w-full px-3 py-2 border border-line bg-white focus:border-gold focus:outline-none" />
        </label>
        <label class="block">
          <span class="text-xs font-bold tracking-widest uppercase text-ink/70">Caduca el</span>
          <input type="date" name="swisstransferExpiresAt" value={ymd(delivery.swisstransferExpiresAt)} class="mt-1 w-full px-3 py-2 border border-line bg-white focus:border-gold focus:outline-none" />
        </label>
      </div>
    </fieldset>

    <fieldset class="space-y-4">
      <legend class="font-display text-xl font-bold mb-1">Galeria de fotos</legend>
      <p class="text-[11px] text-ink/70 -mt-2 mb-2">opcional · enllaç de la galeria de FotoStudio.</p>
      <label class="block max-w-lg">
        <span class="text-xs font-bold tracking-widest uppercase text-ink/70">Enllaç de la galeria</span>
        <input name="galleryUrl" value={delivery.galleryUrl ?? ''} placeholder="https://gallery.fotostudio.io/…" class="mt-1 w-full px-3 py-2 border border-line bg-white focus:border-gold focus:outline-none" />
      </label>

      <div class="pt-2">
        <span class="text-xs font-bold tracking-widest uppercase text-ink/70">Foto de portada de la galeria</span>
        <p class="text-[11px] text-ink/70 mb-2">opcional · una foto de la parella per il·lustrar l'apartat "La vostra galeria". Es redimensiona automàticament. Si no en poses cap, es mostra la icona per defecte.</p>
        <div class="flex flex-wrap items-start gap-4">
          {delivery.hasGalleryCover && (
            <img
              src={`/api/entrega/cover/${delivery.slug}?v=${delivery.updatedAt.getTime()}`}
              alt="Foto de portada actual"
              class="w-40 h-28 object-cover border border-line"
            />
          )}
          <div class="flex-1 min-w-[220px]">
            <input type="file" name="galleryCoverFile" accept="image/jpeg,image/png,image/webp" class="block w-full text-sm text-ink/80 file:mr-3 file:py-2 file:px-4 file:border file:border-line file:bg-cream file:text-xs file:font-bold file:uppercase file:tracking-widest file:text-ink/70 hover:file:border-gold hover:file:text-gold" />
            <p class="text-[11px] text-ink/60 mt-1">JPG, PNG o WEBP · màxim 20 MB.</p>
            {delivery.hasGalleryCover && (
              <label class="flex items-center gap-2 mt-2 text-[11px] text-ink/70">
                <input type="checkbox" name="galleryCoverRemove" class="accent-gold" />
                Treure la foto de portada actual
              </label>
            )}
          </div>
        </div>
      </div>
    </fieldset>

    <fieldset class="space-y-4">
      <legend class="font-display text-xl font-bold mb-1">Cobrament pendent</legend>
      <p class="text-[11px] text-ink/70 -mt-2 mb-2">opcional · si hi poses un import, la pàgina d'entrega mostra un apartat perquè la parella pagui (targeta o transferència). Buit = no apareix.</p>
      <div class="flex flex-wrap items-end gap-3">
        <label class="block">
          <span class="text-xs font-bold tracking-widest uppercase text-ink/70">Import pendent (€)</span>
          <input id="balance-due-field" name="balanceDueEuros" inputmode="decimal" value={eurosField(delivery.balanceDueCents)} placeholder="Ex: 1500 o 1.500,00" class="mt-1 w-48 px-3 py-2 border border-line bg-white focus:border-gold focus:outline-none" />
        </label>
        {linkedBooking && bookingPendingCents > 0 && (
          <button
            type="button"
            id="import-pending-btn"
            data-pending={(bookingPendingCents / 100).toFixed(2).replace('.', ',')}
            class="mb-0.5 border border-line px-3 py-2 text-xs font-bold tracking-widest uppercase text-ink/70 hover:border-gold hover:text-gold transition-colors whitespace-nowrap"
            title={`Importar el pendent de la reserva vinculada (${eurStr(bookingPendingCents)})`}
          >
            ↧ Importar pendent ({eurStr(bookingPendingCents)})
          </button>
        )}
      </div>
      {linkedBooking && bookingPendingCents === 0 && (
        <p class="text-[11px] text-ink/60">La reserva vinculada no té pendent (tot cobrat).</p>
      )}
      {!delivery.bookingId && (
        <p class="text-[11px] text-ink/60">Aquesta entrega no està vinculada a cap reserva — l'import s'introdueix a mà i no es podrà emetre factura automàticament.</p>
      )}
    </fieldset>

    <div class="pt-4 border-t border-line">
      <button type="submit" class="bg-ink text-white px-6 py-3 text-xs font-bold tracking-widest uppercase hover:bg-gold hover:text-ink transition-colors">
        Desar canvis
      </button>
    </div>
  </form>

  {delivery.balanceDueCents && delivery.balanceDueCents > 0 && (
    <div class="mt-6 bg-white border border-line p-5 md:p-6">
      <div class="flex flex-wrap items-center justify-between gap-3 mb-4">
        <div>
          <p class="text-xs font-bold tracking-widest uppercase text-ink/70 mb-1">Cobrament pendent</p>
          <p class="font-display text-2xl font-bold text-gold-deep">{eurStr(delivery.balanceDueCents)}</p>
        </div>
        {delivery.balancePaidAt ? (
          <span class="inline-block bg-emerald-100 text-emerald-800 px-3 py-1 text-xs font-bold uppercase tracking-widest">✓ Pagat {balancePaidStr}</span>
        ) : (
          <span class="inline-block bg-amber-100 text-amber-800 px-3 py-1 text-xs font-bold uppercase tracking-widest">Pendent de cobrament</span>
        )}
      </div>

      <div class="flex flex-wrap items-center gap-3">
        {delivery.balancePaidAt ? (
          <form
            method="POST"
            action={`/api/admin/deliveries/${delivery.id}/update`}
            onsubmit={`return confirm(${JSON.stringify('Desmarcar el pagament del pendent? Tornarà a mostrar-se l\'apartat de pagament a la pàgina d\'entrega.')})`}
          >
            <input type="hidden" name="_action" value="unmark-balance-paid" />
            <button type="submit" class="border border-line px-4 py-2 text-xs font-bold tracking-widest uppercase text-ink/70 hover:border-amber-500 hover:text-amber-700 transition-colors">
              Desmarcar pagament
            </button>
          </form>
        ) : (
          <form method="POST" action={`/api/admin/deliveries/${delivery.id}/update`}>
            <input type="hidden" name="_action" value="mark-balance-paid" />
            <button type="submit" class="bg-emerald-600 text-white px-4 py-2 text-xs font-bold tracking-widest uppercase hover:bg-emerald-700 transition-colors">
              Marcar com a pagat (manual)
            </button>
          </form>
        )}

        {delivery.balanceInvoiceId ? (
          <span class="inline-flex items-center gap-2 text-xs font-bold tracking-widest uppercase text-ink/70">
            🧾 Factura {delivery.balanceInvoiceNumber || delivery.balanceInvoiceId}
          </span>
        ) : delivery.bookingId ? (
          <form
            method="POST"
            action={`/api/admin/deliveries/${delivery.id}/update`}
            onsubmit={`return confirm(${JSON.stringify('Crear la factura del pendent a FacturaDirecta amb les dades fiscals de la reserva vinculada?')})`}
          >
            <input type="hidden" name="_action" value="issue-balance-invoice" />
            <button type="submit" class="border border-line px-4 py-2 text-xs font-bold tracking-widest uppercase text-ink/70 hover:border-gold hover:text-gold transition-colors">
              🧾 Crear factura FacturaDirecta
            </button>
          </form>
        ) : (
          <span class="text-[11px] text-ink/60">Vincula una reserva per poder emetre la factura.</span>
        )}
      </div>

      <p class="text-[11px] text-ink/60 mt-4 leading-relaxed">
        {stripeOn
          ? 'Quan la parella pagui amb targeta, es marca sol i rebràs un avís per Telegram. La factura no es crea automàticament — fes-la aquí amb el botó quan vulguis.'
          : 'Stripe no està configurat: la parella només veurà les dades de transferència. Marca el pagament a mà quan el rebis.'}
      </p>
    </div>
  )}

  <div class="mt-6 bg-white border border-line p-5 md:p-6 flex flex-wrap items-center gap-3">
    {delivery.archived ? (
      <form method="POST" action={`/api/admin/deliveries/${delivery.id}/update`}>
        <input type="hidden" name="_action" value="reactivate" />
        <button type="submit" class="border border-line px-4 py-2 text-xs font-bold tracking-widest uppercase text-ink/70 hover:border-gold hover:text-gold transition-colors">
          Reactivar
        </button>
      </form>
    ) : (
      <form method="POST" action={`/api/admin/deliveries/${delivery.id}/update`}>
        <input type="hidden" name="_action" value="archive" />
        <button type="submit" class="border border-line px-4 py-2 text-xs font-bold tracking-widest uppercase text-ink/70 hover:border-amber-500 hover:text-amber-700 transition-colors">
          Arxivar
        </button>
      </form>
    )}
    <form
      method="POST"
      action={`/api/admin/deliveries/${delivery.id}/update`}
      onsubmit={`return confirm('⚠ Eliminar aquesta entrega DEFINITIVAMENT?\\n\\nNo es podrà recuperar.')`}
    >
      <input type="hidden" name="_action" value="delete" />
      <button type="submit" class="border border-red-200 px-4 py-2 text-xs font-bold tracking-widest uppercase text-red-600 hover:bg-red-50 transition-colors">
        🗑 Eliminar
      </button>
    </form>
  </div>
</AdminLayout>

<script>
  document.getElementById('copy-link-btn')?.addEventListener('click', async (e) => {
    const btn = e.currentTarget as HTMLButtonElement;
    const text = btn.dataset.copy!;
    try {
      await navigator.clipboard.writeText(text);
      const old = btn.textContent;
      btn.textContent = '✓ Copiat';
      setTimeout(() => (btn.textContent = old), 1500);
    } catch {
      prompt('Copia aquest enllaç:', text);
    }
  });

  // "Importar pendent" — fill the balance field with the linked booking's
  // pending balance so it can be reviewed before saving.
  document.getElementById('import-pending-btn')?.addEventListener('click', (e) => {
    const btn = e.currentTarget as HTMLButtonElement;
    const field = document.getElementById('balance-due-field') as HTMLInputElement | null;
    if (field && btn.dataset.pending) {
      field.value = btn.dataset.pending;
      field.focus();
    }
  });
</script>
