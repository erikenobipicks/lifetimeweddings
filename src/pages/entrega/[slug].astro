---
// Public material-delivery landing page. SSR (no prerender) — content
// comes from the deliveries table at request time.
//
// The slug is the only secret protecting this page (couple names + wedding
// date are often guessable) — same security model as /reserva/<slug> and
// /contrato/<slug>. Always noindex,nofollow: shared privately via
// WhatsApp/email only, never meant to appear in search.
//
// No self-hosted media yet: everything here is an embed/link to an
// external service (YouTube unlisted video, SwissTransfer download,
// FotoStudio gallery). Each section only renders when its field is set,
// so a delivery can go out with just the video, just the gallery, etc.

export const prerender = false;

import BaseLayout from '~/layouts/BaseLayout.astro';
import { type Lang } from '~/i18n/ui';
import { SITE, waLink } from '~/data/site';
import { getDeliveryBySlug } from '~/lib/deliveries';
import { formatWeddingDateLong, formatExpiresShort } from '~/lib/bookings/format';
import VideoEmbed from '~/components/reserva/VideoEmbed.astro';
import ExternalGalleryEmbed from '~/components/quote/ExternalGalleryEmbed.astro';
import BalancePayment from '~/components/entrega/BalancePayment.astro';
import Flourish from '~/components/entrega/Flourish.astro';

const slug = Astro.params.slug!;
const delivery = await getDeliveryBySlug(slug);
const available = delivery && !delivery.archived;

// Stripe Checkout return state (?paid=success|cancel) — only meaningful when
// there's a balance section to show.
const paidParam = Astro.url.searchParams.get('paid');
const payState = paidParam === 'success' ? 'success' : paidParam === 'cancel' ? 'cancel' : null;
const hasBalance = !!delivery && !!delivery.balanceDueCents && delivery.balanceDueCents > 0;

if (!available) {
  Astro.response.status = 404;
}

const lang: Lang = delivery ? delivery.preferredLanguage : 'ca';

// Connector between the two names in the hero, styled separately (italic
// gold) from the names themselves: "Júlia i Adrià" / "Júlia y Adrià" /
// "Júlia & Adrià".
const nameSep = lang === 'es' ? 'y' : lang === 'en' ? '&' : 'i';

const TX = {
  ca: {
    title: 'El vostre material',
    eyebrow: 'Lifetime Weddings',
    heading: (n1: string, n2: string) => `${n1} i ${n2}`,
    videoEyebrow: 'El vostre vídeo',
    videoHeading: 'Reviviu el dia',
    trailerEyebrow: 'El tràiler',
    trailerHeading: 'Un tastet del vostre dia',
    downloadHeading: 'Descàrrega en alta qualitat',
    downloadBody: 'Aquí teniu el vídeo complet, llest per descarregar i guardar.',
    downloadCta: 'Descarregar el vídeo',
    downloadExpires: (date: string) => `Disponible fins al ${date} — descarregueu-lo abans que caduqui l'enllaç.`,
    downloadExpired: 'Aquest enllaç de descàrrega ja ha caducat. Escriviu-nos i us en passem un de nou.',
    galleryHeading: 'La vostra galeria',
    galleryEyebrow: 'Fotografies',
    galleryDescription: 'Totes les vostres fotografies',
    galleryNewTab: 'Obrir la galeria',
    reviewEyebrow: 'Un petit favor',
    reviewHeading: 'Ens deixeu una ressenya a Google?',
    reviewBody: 'Som un equip petit i familiar. Si us ha agradat la nostra feina, una ressenya vostra a Google ens ajuda moltíssim a arribar a altres parelles. Amb les vostres paraules, en dos minuts.',
    reviewCta: 'Deixar una ressenya a Google',
    help: 'Si teniu qualsevol dubte o problema amb els enllaços, escriviu-nos.',
    naTitle: 'Enllaç no disponible',
    naBody: 'Aquest enllaç d\'entrega no existeix o ja no està actiu. Si creieu que és un error, escriviu-nos.',
  },
  es: {
    title: 'Vuestro material',
    eyebrow: 'Lifetime Weddings',
    heading: (n1: string, n2: string) => `${n1} y ${n2}`,
    videoEyebrow: 'Vuestro vídeo',
    videoHeading: 'Revivid el día',
    trailerEyebrow: 'El tráiler',
    trailerHeading: 'Un adelanto de vuestro día',
    downloadHeading: 'Descarga en alta calidad',
    downloadBody: 'Aquí tenéis el vídeo completo, listo para descargar y guardar.',
    downloadCta: 'Descargar el vídeo',
    downloadExpires: (date: string) => `Disponible hasta el ${date} — descargadlo antes de que caduque el enlace.`,
    downloadExpired: 'Este enlace de descarga ya ha caducado. Escribidnos y os pasamos uno nuevo.',
    galleryHeading: 'Vuestra galería',
    galleryEyebrow: 'Fotografías',
    galleryDescription: 'Todas vuestras fotografías',
    galleryNewTab: 'Abrir la galería',
    reviewEyebrow: 'Un pequeño favor',
    reviewHeading: '¿Nos dejáis una reseña en Google?',
    reviewBody: 'Somos un equipo pequeño y familiar. Si os ha gustado nuestro trabajo, una reseña vuestra en Google nos ayuda muchísimo a llegar a otras parejas. Con vuestras palabras, en dos minutos.',
    reviewCta: 'Dejar una reseña en Google',
    help: 'Si tenéis cualquier duda o problema con los enlaces, escribidnos.',
    naTitle: 'Enlace no disponible',
    naBody: 'Este enlace de entrega no existe o ya no está activo. Si creéis que es un error, escribidnos.',
  },
  en: {
    title: 'Your material',
    eyebrow: 'Lifetime Weddings',
    heading: (n1: string, n2: string) => `${n1} & ${n2}`,
    videoEyebrow: 'Your film',
    videoHeading: 'Relive the day',
    trailerEyebrow: 'The trailer',
    trailerHeading: 'A taste of your day',
    downloadHeading: 'Download in high quality',
    downloadBody: 'Here is the full film, ready to download and keep.',
    downloadCta: 'Download the film',
    downloadExpires: (date: string) => `Available until ${date} — download it before the link expires.`,
    downloadExpired: 'This download link has expired. Message us and we\'ll send you a new one.',
    galleryHeading: 'Your gallery',
    galleryEyebrow: 'Photography',
    galleryDescription: 'All your photographs',
    galleryNewTab: 'Open the gallery',
    reviewEyebrow: 'A small favour',
    reviewHeading: 'Would you leave us a Google review?',
    reviewBody: 'We\'re a small, family team. If you enjoyed our work, a review on Google helps us reach other couples more than you\'d think. In your own words, in two minutes.',
    reviewCta: 'Leave a Google review',
    help: 'If you have any questions or issues with the links, message us.',
    naTitle: 'Link not available',
    naBody: "This delivery link doesn't exist or is no longer active. If you think this is a mistake, message us.",
  },
}[lang];

const weddingDateLong = delivery ? formatWeddingDateLong(delivery.weddingDate, lang) : '';
const downloadExpired =
  delivery?.swisstransferExpiresAt ? delivery.swisstransferExpiresAt.getTime() < Date.now() : false;
const downloadExpiresShort =
  delivery?.swisstransferExpiresAt ? formatExpiresShort(delivery.swisstransferExpiresAt, lang) : null;

const whatsapp = waLink(
  lang === 'es'
    ? `Hola Lifetime, tengo una duda sobre el material entregado (${slug}).`
    : lang === 'en'
      ? `Hi Lifetime, I have a question about the delivered material (${slug}).`
      : `Hola Lifetime, tinc un dubte sobre el material entregat (${slug}).`,
);

const title = delivery ? `${TX.heading(delivery.coupleName1, delivery.coupleName2)} · Lifetime` : `Lifetime · ${TX.title}`;
---

<BaseLayout
  lang={lang}
  title={title}
  description={title}
  canonicalPath={`/entrega/${slug}`}
  noindex={true}
  chromeless={true}
>
  <!-- Minimal header: logo only, no nav — same treatment as /reserva and
       /cancellacio. Language is locked to the delivery's stored language. -->
  <header class="px-6 md:px-12 py-4 border-b border-line bg-white">
    <a href="/" class="inline-flex items-center gap-2.5">
      <img src="/logos/logo-circle-color.png" alt="Lifetime Weddings" width="36" height="36" class="h-9 w-9" />
      <span class="font-display text-lg font-medium tracking-wide text-ink">
        Lifetime <span class="text-gold-deep">Weddings</span>
      </span>
    </a>
  </header>

  {!available ? (
    <section class="px-6 md:px-12 py-32 md:py-40 bg-cream text-ink text-center">
      <div class="max-w-xl mx-auto">
        <h1 class="font-display text-3xl md:text-4xl font-bold mb-6">{TX.naTitle}</h1>
        <p class="text-ink/75 leading-relaxed mb-8">{TX.naBody}</p>
        <a
          href={`mailto:${SITE.email}`}
          class="inline-block bg-gold text-ink font-bold px-8 py-4 hover:bg-ink hover:text-white transition-colors"
        >
          {SITE.email}
        </a>
      </div>
    </section>
  ) : (
    <>
      <!-- Hero: couple names + date + (optional) venue. Dark, but lifted from
           a flat slab with a soft warm glow, an ornamental divider and
           editorial type so it reads like wedding stationery. -->
      <section class="relative isolate overflow-hidden bg-ink text-white text-center px-6 md:px-12 py-16 md:py-24">
        <div
          class="pointer-events-none absolute inset-0 -z-10"
          style="background: radial-gradient(62% 78% at 50% 32%, rgba(169,136,95,0.20), transparent 72%);"
        >
        </div>
        <div class="max-w-2xl mx-auto">
          <p class="text-[0.7rem] font-semibold tracking-[0.3em] uppercase text-gold mb-6">{TX.eyebrow}</p>
          <h1 class="font-display font-normal leading-[1.06] text-[2.6rem] md:text-6xl">
            {delivery!.coupleName1}<span class="italic text-gold mx-1.5">{nameSep}</span>{delivery!.coupleName2}
          </h1>
          <div class="flex justify-center my-6 md:my-7">
            <Flourish />
          </div>
          <p class="text-[0.72rem] md:text-xs tracking-[0.24em] uppercase text-white/65">
            {weddingDateLong}
            {delivery!.venueName && <> · {delivery!.venueName}</>}
          </p>
        </div>
      </section>

      {delivery!.trailerYoutubeId && (
        <VideoEmbed
          lang={lang}
          youtubeId={delivery!.trailerYoutubeId}
          coupleName={TX.heading(delivery!.coupleName1, delivery!.coupleName2)}
          venue={delivery!.venueName ?? ''}
          eyebrow={TX.trailerEyebrow}
          heading={TX.trailerHeading}
        />
      )}

      {delivery!.youtubeVideoId && (
        <VideoEmbed
          lang={lang}
          youtubeId={delivery!.youtubeVideoId}
          coupleName={TX.heading(delivery!.coupleName1, delivery!.coupleName2)}
          venue={delivery!.venueName ?? ''}
          eyebrow={TX.videoEyebrow}
          heading={TX.videoHeading}
        />
      )}

      {delivery!.swisstransferUrl && (
        <section class="px-6 md:px-12 py-16 md:py-20 bg-cream text-ink">
          <div class="max-w-2xl mx-auto text-center">
            <h2 class="font-display text-2xl md:text-3xl font-bold mb-4">{TX.downloadHeading}</h2>
            <p class="text-ink/75 leading-relaxed mb-6">{TX.downloadBody}</p>
            {downloadExpired ? (
              <p class="mb-6 px-4 py-3 bg-red-50 border border-red-200 text-red-800 text-sm inline-block">
                {TX.downloadExpired}
              </p>
            ) : (
              <>
                <a
                  href={delivery!.swisstransferUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center gap-2.5 bg-ink text-white text-[0.72rem] font-bold uppercase tracking-[0.14em] px-8 py-4 border border-ink hover:bg-gold hover:border-gold hover:text-ink transition-colors"
                >
                  {TX.downloadCta} <span aria-hidden="true">↓</span>
                </a>
                {downloadExpiresShort && (
                  <p class="text-xs text-ink/60 mt-4">{TX.downloadExpires(downloadExpiresShort)}</p>
                )}
              </>
            )}
          </div>
        </section>
      )}

      {delivery!.galleryUrl && (
        <ExternalGalleryEmbed
          lang={lang}
          url={delivery!.galleryUrl}
          heading={TX.galleryHeading}
          eyebrow={TX.galleryEyebrow}
          description={TX.galleryDescription}
          newTabLabel={TX.galleryNewTab}
          coverImageSrc={delivery!.hasGalleryCover
            ? `/api/entrega/cover/${slug}?v=${delivery!.updatedAt.getTime()}`
            : undefined}
        />
      )}

      {hasBalance && (
        <BalancePayment
          lang={lang}
          slug={slug}
          coupleName1={delivery!.coupleName1}
          coupleName2={delivery!.coupleName2}
          amountCents={delivery!.balanceDueCents!}
          paid={!!delivery!.balancePaidAt}
          payState={payState}
        />
      )}

      {/* Google review CTA — always shown (every couple who reaches this
          page has received their material, so it's the natural moment to
          ask). Warm, no-pressure tone; reuses the site's review link. */}
      <section class="px-6 md:px-12 py-16 md:py-20 bg-cream text-ink text-center">
        <div class="max-w-2xl mx-auto">
          <div class="flex justify-center gap-1 text-gold-deep text-xl mb-4" aria-hidden="true">★★★★★</div>
          <p class="text-xs font-bold tracking-[0.22em] uppercase text-gold mb-3">{TX.reviewEyebrow}</p>
          <h2 class="font-display text-2xl md:text-3xl font-bold mb-4">{TX.reviewHeading}</h2>
          <p class="text-ink/75 leading-relaxed mb-8">{TX.reviewBody}</p>
          <a
            href={SITE.googleReviewsUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-3 bg-white border border-line px-7 py-4 text-[0.72rem] font-bold uppercase tracking-[0.14em] hover:border-gold hover:shadow-sm transition-all"
          >
            <svg viewBox="0 0 24 24" class="w-5 h-5" aria-hidden="true">
              <path fill="#4285F4" d="M23.49 12.27c0-.79-.07-1.54-.19-2.27H12v4.51h6.47a5.4 5.4 0 0 1-2.4 3.58v3h3.86c2.26-2.09 3.56-5.17 3.56-8.82z"/>
              <path fill="#34A853" d="M12 24c3.24 0 5.95-1.08 7.93-2.91l-3.86-3c-1.08.72-2.45 1.16-4.07 1.16-3.13 0-5.78-2.11-6.73-4.96H1.29v3.09A12 12 0 0 0 12 24z"/>
              <path fill="#FBBC05" d="M5.27 14.29a7.2 7.2 0 0 1 0-4.58V6.62H1.29a12 12 0 0 0 0 10.76l3.98-3.09z"/>
              <path fill="#EA4335" d="M12 4.75c1.77 0 3.35.61 4.6 1.8l3.42-3.42A12 12 0 0 0 12 0 12 12 0 0 0 1.29 6.62l3.98 3.09C6.22 6.86 8.87 4.75 12 4.75z"/>
            </svg>
            {TX.reviewCta}
          </a>
        </div>
      </section>

      <section class="px-6 md:px-12 py-10 bg-white text-center">
        <p class="text-sm text-ink/70">
          {TX.help}{' '}
          <a href={whatsapp} target="_blank" rel="noopener" class="text-gold-deep font-bold hover:underline">
            WhatsApp
          </a>
        </p>
      </section>
    </>
  )}

  <!-- Minimal footer: legal-only, no public nav. -->
  <footer class="px-6 md:px-12 py-12 bg-ink text-center">
    <p class="font-display text-xl md:text-2xl font-medium tracking-wide text-white mb-4">
      Lifetime <span class="text-gold">Weddings</span>
    </p>
    <div class="flex justify-center mb-5">
      <Flourish />
    </div>
    <p class="text-xs text-white/55">© {new Date().getFullYear()} Lifetime Weddings · {SITE.address.city}</p>
  </footer>
</BaseLayout>
